# The emulator core's C API (app/src/main/cpp/pk_api.h) for Kotlin on iOS. The library is built by
# shared/native/build_ios_core.sh; shared/build.gradle.kts passes its folder (-libraryPath) and pk_api.h's (includeDirs).
headers = pk_api.h
headerFilter = pk_api.h
package = com.pokedaisy.app.core.pkapi
staticLibraries = libpkcore.a
